POSTGRES_DB=hypernova
POSTGRES_USER=hypernova
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://hypernova:change-me-local-only@postgres:5432/hypernova?sslmode=disable

API_PORT=8080
WEB_PORT=4173
TIGERBEETLE_ADDRESS=tigerbeetle:3000
TIGERBEETLE_VERSION=0.15.4
# Development-only clearing account used by the demo deposit endpoint.
# Keep false in production and use a trusted funding workflow.
LEDGER_ALLOW_DEMO_DEPOSITS=true
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
API_RATE_LIMIT_PER_MINUTE=120
MFA_ENCRYPTION_KEY=

# OAuth is disabled until each provider has all three values configured.
# Register these exact callback URLs in the provider consoles.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback
OAUTH_STATE_TTL=10m
OAUTH_EXCHANGE_TTL=2m
# Exact browser origin/deep link targets accepted by the OAuth callback.
# Add the exact web origin used in the browser when testing from another device.
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:4173/,http://127.0.0.1:4173/,hypernova://oauth

VITE_API_BASE_URL=/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
